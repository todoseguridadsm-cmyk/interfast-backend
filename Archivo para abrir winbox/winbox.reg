@echo off
set "URL=%~1"

:: Invocamos PowerShell de forma silenciosa para decodificar y ejecutar
powershell -NoProfile -WindowStyle Hidden -Command ^
  "$payload = '%URL%'.Replace('winbox://', '').Trim('/'); "^
  "$decoded = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($payload)); "^
  "$parts = $decoded.Split('|'); "^
  "$exe = 'C:\Users\MATIAS BRANDI\Desktop\winBox.exe'; "^
  "Start-Process -FilePath $exe -ArgumentList $parts;"
