generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id                   Int                   @id @default(autoincrement())
  dni                  String
  name                 String
  email                String?
  phone                String?
  address              String?
  city                 String?
  province             String?
  mainNode             String?
  panelId              String?
  ipNumber             String?
  cuit                 String?
  taxCondition         String                @default("CONSUMIDOR_FINAL")
  status               String                @default("ACTIVE")
  planId               Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  walletBalance        Float                 @default(0.0)
  hasMast              Boolean               @default(false)
  hasRouter            Boolean               @default(false)
  businessName         String?
  fiscalAddress        String?
  registrationDate     DateTime?
  zipCode              String?
  observation          String?
  phone2               String?
  cancellationRequests CancellationRequest[]
  plan                 Plan?                 @relation(fields: [planId], references: [id])
  cutoffLists          CutoffList[]
  invoices             Invoice[]
  tickets              Ticket[]
}

model Plan {
  id         Int      @id @default(autoincrement())
  name       String
  megas      Int
  basePrice  Float
  ivaAmount  Float
  totalPrice Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  priceV1    Float    @default(0)
  priceV2    Float    @default(0)
  priceV3    Float    @default(0)
  priceV4    Float    @default(0)
  dueDate1   Int      @default(10)
  dueDate2   Int      @default(15)
  dueDate3   Int      @default(20)
  dueDate4   Int      @default(22)
  clients    Client[]
}

model Invoice {
  id             Int       @id @default(autoincrement())
  clientId       Int
  month          Int
  year           Int
  originalAmount Float
  dueDate        DateTime
  status         String    @default("PENDING")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  priceV1        Float     @default(0)
  priceV2        Float     @default(0)
  priceV3        Float     @default(0)
  priceV4        Float     @default(0)
  dueDate1       DateTime?
  dueDate2       DateTime?
  dueDate3       DateTime?
  dueDate4       DateTime?
  afipCae        String?
  afipCbteNro    Int?
  afipCbteTip    Int?
  afipPuntoVenta Int?
  afipVtoCae     String?
  notifiedAt     DateTime?
  client         Client    @relation(fields: [clientId], references: [id])
  payments       Payment[]
}

model Payment {
  id             Int      @id @default(autoincrement())
  invoiceId      Int
  method         String
  amountPaid     Float
  lateFeeApplied Float    @default(0.0)
  paymentDate    DateTime @default(now())
  userId         Int?
  mpFee          Float    @default(0.0)
  mpTax          Float    @default(0.0)
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  user           User?    @relation(fields: [userId], references: [id])
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  passwordHash  String
  role          String         @default("STAFF")
  permissions   String         @default("[]")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cashMovements CashMovement[]
  payments      Payment[]
}

model CashMovement {
  id          Int      @id @default(autoincrement())
  type        String
  amount      Float
  description String
  userId      Int
  createdAt   DateTime @default(now())
  category    String   @default("GASTO_GENERAL")
  user        User     @relation(fields: [userId], references: [id])
}

model Ticket {
  id             Int             @id @default(autoincrement())
  clientId       Int
  title          String
  description    String
  status         String          @default("OPEN")
  priority       String          @default("NORMAL")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  mastProvided   Boolean         @default(false)
  routerProvided Boolean         @default(false)
  scheduledAt    DateTime?
  client         Client          @relation(fields: [clientId], references: [id])
  history        TicketHistory[]
}

model TicketHistory {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  action    String
  notes     String?
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
}

model historial_mensajes {
  id         Int      @id @default(autoincrement())
  phone      String
  remitente  String
  mensaje    String
  created_at DateTime @default(now())
}

model CutoffList {
  id        Int      @id @default(autoincrement())
  clientId  Int
  invoiceId Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id])
}

model CancellationRequest {
  id          Int       @id @default(autoincrement())
  clientId    Int
  reason      String?
  status      String    @default("PENDING")
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?
  client      Client    @relation(fields: [clientId], references: [id])
}

model CatalogItem {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  price       Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSettings {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Lead {
  id        Int      @id @default(autoincrement())
  phone     String
  name      String?
  address   String?
  latitude  Float?
  longitude Float?
  status    String   @default("NEW")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Node {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  host      String
  port      Int      @default(8728)
  user      String
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model content_library {
  id             BigInt    @id(map: "ContentLibrary_pkey") @default(autoincrement())
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  titulo         String?
  contenido_post String?
  tipo_media     String?
  estado         String?   @default("Pendiente")
  link_landing   String?   @default("https://interfast-web.vercel.app/")
  url_media      String?
}

