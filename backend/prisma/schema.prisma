generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id        Int       @id @default(autoincrement())
  dni       String
  name      String
  businessName String?
  email     String?
  phone     String?
  phone2    String?
  observation String?
  address   String?
  fiscalAddress String?
  city        String?
  province    String?
  zipCode     String?
  mainNode    String?
  panelId     String?
  ipNumber    String?
  cuit      String?
  taxCondition String @default("CONSUMIDOR_FINAL")
  status    String    @default("ACTIVE") // "ACTIVE", "SUSPENDED", "BAJA"
  walletBalance Float @default(0.0)
  hasRouter Boolean @default(false)
  hasMast   Boolean @default(false)
  planId    Int?
  plan      Plan?     @relation(fields: [planId], references: [id])
  invoices  Invoice[]
  tickets   Ticket[]
  cutoffLists CutoffList[]
  cancellationRequests CancellationRequest[]
  registrationDate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Plan {
  id        Int      @id @default(autoincrement())
  name      String
  megas     Int
  basePrice  Float
  ivaAmount  Float
  totalPrice Float
  
  priceV1   Float    @default(0.0)
  dueDate1  Int      @default(10)
  
  priceV2   Float    @default(0.0)
  dueDate2  Int      @default(15)
  
  priceV3   Float    @default(0.0)
  dueDate3  Int      @default(20)

  clients    Client[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id            Int       @id @default(autoincrement())
  clientId      Int
  client        Client    @relation(fields: [clientId], references: [id])
  month         Int
  year          Int
  originalAmount Float
  dueDate       DateTime

  priceV1   Float    @default(0.0)
  dueDate1  DateTime?
  priceV2   Float    @default(0.0)
  dueDate2  DateTime?
  priceV3   Float    @default(0.0)
  dueDate3  DateTime?

  status        String    @default("PENDING") // "PENDING", "PAID"
  notifiedAt    DateTime?
  
  afipCae         String?
  afipVtoCae      String?
  afipCbteTip     Int?
  afipPuntoVenta  Int?
  afipCbteNro     Int?

  payments      Payment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Payment {
  id            Int      @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  method        String   // "MERCADOPAGO", "CASH", "TRANSFER"
  amountPaid    Float
  mpFee         Float    @default(0.0)
  mpTax         Float    @default(0.0)
  lateFeeApplied Float    @default(0.0)
  paymentDate   DateTime @default(now())
  userId        Int?
  user          User?    @relation(fields: [userId], references: [id])
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  passwordHash   String
  role           String   @default("STAFF")
  permissions    String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cashMovements  CashMovement[]
  payments       Payment[]
}

model CashMovement {
  id          Int      @id @default(autoincrement())
  type        String   // "IN" or "OUT"
  amount      Float
  category    String   @default("GASTO_GENERAL")
  description String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Ticket {
  id             Int             @id @default(autoincrement())
  clientId       Int
  client         Client          @relation(fields: [clientId], references: [id])
  title          String
  description    String
  status         String          @default("OPEN")
  priority       String          @default("NORMAL")
  scheduledAt    DateTime?
  routerProvided Boolean         @default(false)
  mastProvided   Boolean         @default(false)
  history        TicketHistory[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model TicketHistory {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  action    String
  notes     String?
  createdAt DateTime @default(now())
}

model historial_mensajes {
  id         Int      @id @default(autoincrement())
  phone      String
  remitente  String
  mensaje    String
  created_at DateTime @default(now())
}

model CutoffList {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id])
  invoiceId Int
  status    String   @default("PENDING") // PENDING (Cortado) o RESOLVED (Pagado/Eximido)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CancellationRequest {
  id          Int      @id @default(autoincrement())
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id])
  reason      String?
  status      String   @default("PENDING") // PENDING, CONFIRMED, RESTORED
  requestedAt DateTime @default(now())
  resolvedAt  DateTime?
}

model CatalogItem {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  price       Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSettings {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Lead {
  id          Int      @id @default(autoincrement())
  phone       String
  name        String?
  address     String?
  latitude    Float?
  longitude   Float?
  status      String   @default("NEW")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Node {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  host      String
  port      Int      @default(8728)
  user      String
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model content_library {
  id             Int      @id @default(autoincrement())
  created_at     DateTime @default(now())
  titulo         String?
  contenido_post String
  tipo_media     String?
  estado         String   @default("Pendiente")
  link_landing   String?  @default("https://interfast-web.vercel.app/")
  url_media      String?
}